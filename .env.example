# Copiá este archivo como .env.local y completalo con los datos de TU proyecto Supabase
# (Supabase → Project Settings → API Keys). .env.local nunca se sube a Git.

# URL del proyecto, por ejemplo https://<id-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("publishable", empieza con sb_publishable_; la antigua "anon" también sirve).
# Es segura en el navegador porque el acceso a los datos lo controlan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (empieza con sb_secret_; la antigua "service_role" también sirve).
# Se usa SOLO en el servidor para crear empleados, cambiar contraseñas y bloquear cuentas.
# IMPORTANTE: NUNCA le agregues el prefijo NEXT_PUBLIC_ ni la compartas con nadie.
SUPABASE_SECRET_KEY=

# Dirección pública de la app, sin barra final (se usa en los códigos QR).
# Ejemplo: https://asistencia.tunegocio.com — dejala vacía mientras pruebes en tu computadora.
APP_URL=

# Claves para los avisos (notificaciones) a los administradores cuando un empleado marca.
# Se generan una sola vez con: npx web-push generate-vapid-keys
# La pública se entrega al navegador; la privada es SECRETA (sin NEXT_PUBLIC_).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Clave para el cierre mensual automático de tardanzas (tarea programada de Netlify).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIERRE_SECRET=

# --- Archivo aparte: .env.migraciones (NO en .env.local) ---
# Cadena de conexión a la base, solo para aplicar migraciones con: npm run db:migrar.
# Va separada para que la contraseña de la base nunca se publique con la app.
# Supabase → botón "Connect" → Connection string → URI → "Session pooler".
# Reemplazá [YOUR-PASSWORD] (con corchetes incluidos) por la contraseña de la base.
# SUPABASE_DB_URL=
